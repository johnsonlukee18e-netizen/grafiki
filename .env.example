# ---------------------------------------------------------------------------
# Nurse Scheduler - environment template. Copy to .env and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=nurse
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nurse
# Host port exposed by docker-compose.dev.yml (local development only)
POSTGRES_PORT=5433
# Used by the backend. Inside Docker the host is the compose service name.
DATABASE_URL=postgresql+psycopg://nurse:change-me-strong-password@postgres:5432/nurse

# --- session ---------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32-value-at-least-32-chars
SESSION_MAX_AGE_SECONDS=28800

# --- Google OAuth 2.0 / OpenID Connect -------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly one of the "Authorized redirect URIs" in Google Console.
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
# Optional: restrict logins to one Google Workspace domain (leave empty for any)
GOOGLE_ALLOWED_DOMAIN=

# --- ports (loopback only) -------------------------------------------------
# This stack never binds to 80/443 or terminates TLS - it publishes the
# backend and frontend on 127.0.0.1 only. Put the reverse proxy you already
# run on this host in front of them and let it (or Cloudflare) own HTTPS.
# See README, section "Reverse proxy i TLS", and docs/nginx-host-example.conf.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- frontend --------------------------------------------------------------
# The public URL users actually visit (used for redirects and CORS).
FRONTEND_URL=https://your-domain.example
# Comma separated list; defaults to FRONTEND_URL when empty.
CORS_ORIGINS=

# --- bootstrap / access control --------------------------------------------
# These e-mails receive the ADMIN role on their first Google login and are
# active immediately. Comma separated. Only applies when the account is
# created - an existing account is changed in the USERS panel instead.
INITIAL_ADMIN_EMAILS=your.admin@example.com

# A successful Google login proves identity, NOT authorisation: the Google
# consent screen is not an access control list. With this left at false every
# other new account is created locked and an ADMIN activates it in the USERS
# panel. Only set it to true if anyone able to log in with Google should get
# access to employee data straight away.
AUTO_ACTIVATE_NEW_USERS=false

# --- local development only (ignored when APP_ENV=production) --------------
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=dev.admin@example.com

# --- solver ----------------------------------------------------------------
SOLVER_TIME_LIMIT_SECONDS=60
SOLVER_SEED=42
SOLVER_WORKERS=8
# Ceiling for the time limit set in USTAWIENIA. Generation runs inside the
# HTTP request and Cloudflare cuts requests at 100 s - keep this below ~80.
SOLVER_MAX_SECONDS=75

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=20
