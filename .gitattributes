# Normalise line endings so files checked out on Windows still work in Docker.
* text=auto eol=lf

# Shell scripts and Docker files MUST keep LF: a CRLF shebang breaks with
# "bad interpreter: /usr/bin/env bash^M" inside the Linux containers.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
*.woff binary
*.woff2 binary
